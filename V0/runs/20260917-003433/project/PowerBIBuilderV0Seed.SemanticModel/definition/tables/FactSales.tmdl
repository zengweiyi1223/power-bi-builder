	column Quantity
		dataType: int64
		lineageTag: 41540636-6334-4c2c-84e8-7f8d5440f1d1
		sourceColumn: Quantity

	column UnitPrice
		dataType: decimal
		lineageTag: be1ed6ef-469c-4ea9-a606-a97a18f44af4
		sourceColumn: UnitPrice

	column UnitCost
		dataType: decimal
		lineageTag: 12188c54-5a3f-4ba6-ae7f-67cfce4d25b0
		sourceColumn: UnitCost

	partition FactSales = m
		mode: import
		source = SalesSource

