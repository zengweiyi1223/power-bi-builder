# Power BI machine-local state
**/.pbi/localSettings.json
**/.pbi/editorSettings.json
**/.pbi/cache.abf
**/.pbi/cache.*
**/.pbi/AutoRecovery/
**/.pbi/autorecovery/
*.pbix.autorecover
*.pbip.autorecover
~$*.pbix
~$*.pbip

# Python bytecode and tool caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Python virtual environments
.venv/
venv/
env/
ENV/

# Disposable V0 workspace
V0/.work/

# Formal V0 runs are intentionally tracked; do not ignore V0/runs/.

# Windows and common OS metadata
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store

# Temporary, backup, and editor swap files
*.tmp
*.temp
*.bak
*.orig
*.rej
*.swp
*.swo
*~
.#*
\#*#
