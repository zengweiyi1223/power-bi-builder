# Normalize text in the repository. Explicit LF is limited to files authored outside Desktop.
* text=auto

.gitattributes text eol=lf
.gitignore text eol=lf
*.gitkeep text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.log text eol=lf
*.csv text eol=lf
*.py text eol=lf
*.html text eol=lf
*.json text eol=lf

# Pinned Desktop 2.157.1354.0 samples (2026-09-17): PBIR JSON and TMDL were
# UTF-8 without BOM and used CRLF; Desktop may omit the final JSON newline.
# Preserve Power BI source bytes; Desktop can also reserialize JSON on save.
V0/seed/**/*.json -text !eol
V0/runs/**/project/**/*.json -text !eol
*.tmdl -text !eol
*.pbir -text !eol
*.pbip -text !eol
*.pbism -text !eol

# Known binary artifacts
*.abf binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
