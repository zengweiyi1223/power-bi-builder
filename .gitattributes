# Normalize text in the repository. Explicit LF is limited to files authored outside Desktop.
* text=auto

.gitattributes text eol=lf
.gitignore text eol=lf
*.gitkeep text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.log text eol=lf
*.csv text eol=lf
*.py text eol=lf
*.json text eol=lf

# Do not normalize Power BI project sources before observing Desktop output.
# Revisit in a separate commit after the pinned Desktop version creates the seed.
V0/seed/**/*.json -text !eol
V0/runs/**/project/**/*.json -text !eol
*.tmdl -text !eol
*.pbir -text !eol
*.pbip -text !eol
*.pbism -text !eol

# Known binary artifacts
*.abf binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
